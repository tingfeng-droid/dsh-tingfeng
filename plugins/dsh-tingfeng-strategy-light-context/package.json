{
  "name": "dsh-tingfeng-strategy-light-context",
  "version": "0.12.0",
  "description": "Additive shared projection budget cap for any Mnemon main Strategy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-tingfeng": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dsh-tingfeng": "workspace:*",
    "dsh-tingfeng-strategy-default-three-tier": "workspace:*",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tingfeng-droid/dsh-tingfeng.git",
    "directory": "plugins/dsh-tingfeng-strategy-light-context"
  },
  "homepage": "https://github.com/tingfeng-droid/dsh-tingfeng/tree/main/plugins/dsh-tingfeng-strategy-light-context#readme",
  "bugs": {
    "url": "https://github.com/tingfeng-droid/dsh-tingfeng/issues"
  }
}
